<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Enrollment - 1440 x 1024</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
  body{background:#0f1e3d;color:#222}
  .topbar{background:#0f1e3d;color:white;padding:18px 30px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0}
  .topbar h1{font-size:22px}
  .topbar p{font-size:13px;color:#f5b301}
  nav a{color:white;text-decoration:none;background:#2b3a5e;padding:9px 14px;border-radius:20px;font-size:13px;margin-left:6px}
  nav a:hover{background:#f5b301;color:#000}
  .wrap{max-width:1440px;margin:0 auto;padding:24px}
  .frame{background:white;border-radius:16px;padding:28px;margin-bottom:30px;min-height:1024px}
  .frame-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
  .frame-head h2{font-size:26px;color:#0f1e3d}
  .badge{background:#fff3cd;color:#7a5a00;padding:7px 12px;border-radius:20px;font-size:13px;font-weight:bold}
  .badge-red{background:#ffe0e0;color:#b00000}
  .badge-green{background:#d9f7dd;color:#0a6b1a}
  .badge-blue{background:#ddeaff;color:#0f1e3d}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .full{grid-column:span 2}
  label{font-weight:bold;font-size:14px;display:block;margin-bottom:6px}
  label span{color:red}
  input,select{width:100%;padding:13px;border:2px solid #d0d5dd;border-radius:10px;font-size:15px}
  input:focus,select:focus{outline:none;border-color:#0f1e3d}
  .hint{font-size:12px;color:#777;margin-top:5px}
  .error-input{border-color:#e53935 !important;background:#fff5f5}
  .error-text{color:#e53935;font-size:13px;margin-top:5px;font-weight:bold}
  .btn-row{display:flex;gap:12px;margin-top:22px}
  .btn{padding:13px 24px;border:none;border-radius:10px;font-size:15px;font-weight:bold;cursor:pointer;text-decoration:none;text-align:center}
  .btn-blue{background:#0f1e3d;color:white;flex:1}
  .btn-yellow{background:#f5b301;color:#000;flex:1}
  .btn-outline{background:white;border:2px solid #0f1e3d;color:#0f1e3d}
  table{width:100%;border-collapse:collapse;margin-top:10px;font-size:14px}
  th{background:#0f1e3d;color:white;padding:13px;text-align:left}
  td{padding:13px;border-bottom:1px solid #eee}
  tr:nth-child(even) td{background:#f8f9ff}
  .pill{padding:5px 10px;border-radius:20px;font-size:12px;font-weight:bold}
  .pill-bsit{background:#ddeaff;color:#0f1e3d}
  .pill-bsed{background:#d9f7dd;color:#0a6b1a}
  .pill-bsba{background:#fff3cd;color:#7a5a00}
  .cards{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:16px;margin:18px 0}
  .card{border:2px solid #eee;border-radius:14px;padding:18px;text-align:center}
  .card b{font-size:36px;color:#0f1e3d;display:block}
  .card span{font-size:13px;color:#666}
  .bar-row{display:flex;align-items:center;gap:12px;margin:10px 0;font-size:14px}
  .bar{height:18px;border-radius:20px;background:#0f1e3d}
  .bar2{background:#f5b301}
  .bar3{background:#2ecc71}
  .footer{text-align:center;color:white;padding:10px 0 30px;font-size:13px}
  @media(max-width:700px){.form-grid,.cards{grid-template-columns:1fr}.full{grid-column:span 1}.topbar{flex-direction:column;gap:10px}}
</style>
</head>
<body>

<div class="topbar">
  <div><h1>Student Enrollment</h1><p>LAB PART A - 1440 x 1024 Frame - HTML + CSS Only</p></div>
  <nav>
    <a href="#blank">1. Blank Form</a>
    <a href="#error">2. With Errors</a>
    <a href="#table">3. Student Table</a>
    <a href="#summary">4. Summary</a>
  </nav>
</div>

<div class="wrap">

<!-- FRAME 1: BLANK FORM -->
<div class="frame" id="blank">
  <div class="frame-head"><h2>Frame 1: Blank Form</h2><span class="badge">FRAME 1 / 4</span></div>
  <p style="margin-bottom:18px;color:#555">Fill up all required fields marked with <span style="color:red">*</span></p>
  <div class="form-grid">
    <div><label>Student ID <span>*</span></label><input type="text" placeholder="Ex: 2026-001"><div class="hint">Example: 2026-001</div></div>
    <div><label>Full Name <span>*</span></label><input type="text" placeholder="Ex: Juan Dela Cruz"></div>
    <div><label>Email <span>*</span></label><input type="email" placeholder="Ex: juan@gmail.com"></div>
    <div><label>Age <span>*</span></label><input type="number" placeholder="Ex: 18"></div>
    <div><label>Course <span>*</span></label>
      <select><option>Select Course</option><option>BSIT</option><option>BSBA</option><option>BSED</option></select></div>
    <div><label>Year Level <span>*</span></label>
      <select><option>Select Year Level</option><option>1st Year</option><option>2nd Year</option><option>3rd Year</option><option>4th Year</option></select></div>
  </div>
  <div class="btn-row"><a class="btn btn-blue" href="#table">Submit & View Table →</a><a class="btn btn-yellow" href="#summary">View Summary Report</a></div>
</div>

<!-- FRAME 2: FORM WITH ERRORS -->
<div class="frame" id="error">
  <div class="frame-head"><h2>Frame 2: Form With Errors</h2><span class="badge badge-red">ERROR STATE</span></div>
  <p style="margin-bottom:18px;color:#b00000"><b>Please fix 4 errors below before submitting.</b></p>
  <div class="form-grid">
    <div><label>Student ID <span>*</span></label><input class="error-input" type="text" value=""><div class="error-text">✕ Student ID is required</div></div>
    <div><label>Full Name <span>*</span></label><input type="text" value="Juan Dela Cruz"></div>
    <div><label>Email <span>*</span></label><input class="error-input" type="text" value="juangmail"><div class="error-text">✕ Invalid email - missing @</div></div>
    <div><label>Age <span>*</span></label><input class="error-input" type="text" value="12"><div class="error-text">✕ Age must be 15 and above</div></div>
    <div><label>Course <span>*</span></label><select class="error-input"><option>Select Course</option></select><div class="error-text">✕ Please select a course</div></div>
    <div><label>Year Level <span>*</span></label><select><option>2nd Year</option></select></div>
  </div>
  <div class="btn-row"><a class="btn btn-blue" href="#blank">← Back to Blank Form</a><a class="btn btn-yellow" href="#table">Fix & Submit</a></div>
</div>

<!-- FRAME 3: STUDENT TABLE -->
<div class="frame" id="table" style="min-height:auto">
  <div class="frame-head"><h2>Frame 3: Student Table</h2><span class="badge badge-green">6 STUDENTS ENROLLED</span></div>
  <table>
    <tr><th>ID</th><th>Name</th><th>Email</th><th>Age</th><th>Course</th><th>Year</th></tr>
    <tr><td>2026-001</td><td>Juan Dela Cruz</td><td>juan@gmail.com</td><td>18</td><td><span class="pill pill-bsit">BSIT</span></td><td>1st Year</td></tr>
    <tr><td>2026-002</td><td>Maria Santos</td><td>maria@gmail.com</td><td>19</td><td><span class="pill pill-bsed">BSED</span></td><td>2nd Year</td></tr>
    <tr><td>2026-003</td><td>Jose Rizal Jr.</td><td>jose@gmail.com</td><td>20</td><td><span class="pill pill-bsba">BSBA</span></td><td>3rd Year</td></tr>
    <tr><td>2026-004</td><td>Ana Reyes</td><td>ana@gmail.com</td><td>18</td><td><span class="pill pill-bsit">BSIT</span></td><td>1st Year</td></tr>
    <tr><td>2026-005</td><td>Mark Villanueva</td><td>mark@gmail.com</td><td>21</td><td><span class="pill pill-bsba">BSBA</span></td><td>4th Year</td></tr>
    <tr><td>2026-006</td><td>Liza Garcia</td><td>liza@gmail.com</td><td>19</td><td><span class="pill pill-bsed">BSED</span></td><td>2nd Year</td></tr>
  </table>
  <div class="btn-row"><a class="btn btn-outline" href="#blank">+ Add New Student</a><a class="btn btn-blue" href="#summary">View Summary Report →</a></div>
</div>

<!-- FRAME 4: SUMMARY REPORT -->
<div class="frame" id="summary" style="min-height:auto">
  <div class="frame-head"><h2>Frame 4: Summary Report</h2><span class="badge badge-blue">SCHOOL YEAR 2026-2027</span></div>
  <div class="cards">
    <div class="card"><b>6</b><span>Total Students</span></div>
    <div class="card"><b>2</b><span>BSIT Students</span></div>
    <div class="card"><b>2</b><span>BSBA Students</span></div>
    <div class="card"><b>2</b><span>BSED Students</span></div>
  </div>
  <h3>By Course</h3>
  <div class="bar-row"><span style="width:60px">BSIT</span><div class="bar" style="width:33%"></div><span>2</span></div>
  <div class="bar-row"><span style="width:60px">BSBA</span><div class="bar bar2" style="width:33%"></div><span>2</span></div>
  <div class="bar-row"><span style="width:60px">BSED</span><div class="bar bar3" style="width:33%"></div><span>2</span></div>
  <h3 style="margin-top:20px">By Year Level</h3>
  <p style="margin-top:8px">1st Year: 2 students • 2nd Year: 2 students • 3rd Year: 1 student • 4th Year: 1 student</p>
  <p style="margin-top:12px;background:#f8f9ff;padding:14px;border-radius:10px"><b>Insight:</b> Most students are in 1st Year and 2nd Year. BSIT, BSBA, and BSED are equal.</p>
  <div class="btn-row"><a class="btn btn-blue" href="#blank">← Back to Enrollment Form</a><a class="btn btn-yellow" href="#table">View Full Table</a></div>
</div>

</div>
<div class="footer">Student Enrollment System • Designed in HTML + CSS Only • All 4 Frames in 1 File</div>
</body>
</html>
